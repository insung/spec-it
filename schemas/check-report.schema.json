{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-it.example/schemas/check-report.schema.json",
  "title": "spec-it check report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "commit", "policy_version", "overall", "summary", "results"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "mode": {"enum": ["quick", "full", "release"]},
    "commit": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "overall": {"enum": ["pass", "warn", "fail", "human-review"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "not-applicable", "human-review"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "not-applicable": {"type": "integer", "minimum": 0},
        "human-review": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "status", "message"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"},
          "status": {"enum": ["pass", "warn", "fail", "not-applicable", "human-review"]},
          "message": {"type": "string"},
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "finding_type": {"type": "string"},
          "masked_fingerprint": {"type": "string"},
          "remediation": {"type": "string"}
        }
      }
    }
  }
}
