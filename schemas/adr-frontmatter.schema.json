{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-it.example/schemas/adr-frontmatter.schema.json",
  "title": "spec-it ADR front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "date", "owners", "rules", "review_triggers"],
  "properties": {
    "id": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]},
    "date": {"type": "string", "format": "date"},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rules": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"}},
    "review_triggers": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "string", "pattern": "^ADR-[0-9]{4}$"}
  }
}
