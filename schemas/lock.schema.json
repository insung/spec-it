{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-it.example/schemas/lock.schema.json",
  "title": "spec-it resolved lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated", "policy", "manifest_digest", "profiles", "rules", "parameters", "exceptions"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "generated": {"const": true},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version"],
      "properties": {"source": {"type": "string"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "enforcement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"},
          "source": {"type": "string"},
          "enforcement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "implementation"],
            "properties": {
              "mode": {"enum": ["manual", "validator", "ci", "runtime"]},
              "implementation": {"enum": ["planned", "advisory", "implemented"]}
            }
          }
        }
      }
    },
    "parameters": {"type": "object"},
    "exceptions": {"type": "array", "items": {"type": "string"}}
  }
}
