{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-it.example/schemas/exception.schema.json",
  "title": "spec-it policy exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "rule_id", "reason", "impact", "approvers"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"},
    "reason": {"type": "string", "minLength": 10},
    "impact": {"type": "string", "minLength": 10},
    "approvers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expires_on": {"type": "string", "format": "date"},
    "review_trigger": {"type": "string", "minLength": 5}
  },
  "oneOf": [
    {"required": ["expires_on"]},
    {"required": ["review_trigger"]}
  ]
}
