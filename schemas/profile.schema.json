{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-it.example/schemas/profile.schema.json",
  "title": "spec-it composable profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "axis", "version", "status", "description", "applies_when", "rules", "parameters", "evidence", "conflicts"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "profile_id": {"type": "string", "pattern": "^(risk|project-kind|language|runtime|deployment|capability)/[a-z0-9-]+$"},
    "axis": {"enum": ["risk", "project-kind", "language", "runtime", "deployment", "capability"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "description": {"type": "string", "minLength": 1},
    "traits": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["infrastructure"]}
    },
    "applies_when": {"type": "array", "items": {"type": "string"}},
    "rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"}},
    "parameters": {"type": "object"},
    "evidence": {"type": "object"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_signals", "required_decisions", "failure_scenarios", "cost_drivers", "measurements", "guardrails", "evidence_stages", "revisit_triggers"],
      "properties": {
        "activation_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cost_drivers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "measurements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["estimate", "development-benchmark", "non-production-observation", "pre-production-risk-test", "operations"]}
        },
        "revisit_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(risk|project-kind|language|runtime|deployment|capability)/[a-z0-9-]+$"}}
  },
  "allOf": [
    {
      "if": {
        "required": ["traits"],
        "properties": {"traits": {"contains": {"const": "infrastructure"}}}
      },
      "then": {"required": ["evaluation"]}
    }
  ]
}
