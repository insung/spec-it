{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/absolute/path/to/spec-it/tools/spec_it_hook.py",
              "--enabled",
              "--project-root",
              "${CLAUDE_PROJECT_DIR}",
              "--policy-root",
              "/absolute/path/to/spec-it"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/absolute/path/to/spec-it/tools/spec_it_hook.py",
              "--enabled",
              "--project-root",
              "${CLAUDE_PROJECT_DIR}",
              "--policy-root",
              "/absolute/path/to/spec-it"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit|Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/absolute/path/to/spec-it/tools/spec_it_hook.py",
              "--enabled",
              "--project-root",
              "${CLAUDE_PROJECT_DIR}",
              "--policy-root",
              "/absolute/path/to/spec-it"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/absolute/path/to/spec-it/tools/spec_it_hook.py",
              "--enabled",
              "--project-root",
              "${CLAUDE_PROJECT_DIR}",
              "--policy-root",
              "/absolute/path/to/spec-it"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/absolute/path/to/spec-it/tools/spec_it_hook.py",
              "--enabled",
              "--project-root",
              "${CLAUDE_PROJECT_DIR}",
              "--policy-root",
              "/absolute/path/to/spec-it"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
